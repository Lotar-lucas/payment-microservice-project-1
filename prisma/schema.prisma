// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  CANCELED
}

enum RefundStatus {
  REQUESTED
  PROCESSED
  FAILED
}

enum AttemptOperation {
  CAPTURE
  REFUND
}

enum AttemptStatus {
  SUCCESS
  ERROR
}

enum EventType {
  PAYMENT_CREATED
  CAPTURED
  FAILED
  REFUND_REQUESTED
  REFUND_PROCESSED
  REFUND_FAILED
  CANCELED
}

model PaymentMethod {
  id        String   @id @default(cuid())
  code      String   @unique // "pix", "credit_card"
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  amount         Decimal       @db.Decimal(12, 2)
  capturedAmount Decimal?      @db.Decimal(12, 2) // setar = amount quando CAPTURED
  currency       String        @db.VarChar(3)
  status         PaymentStatus @default(PENDING)
  methodId       String
  method         PaymentMethod @relation(fields: [methodId], references: [id])
  metadata       Json?         @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relacionamentos
  attempts PaymentAttempt[]
  refunds  Refund[]
  events   PaymentEvent[]

  @@index([status])
  @@index([orderId])
  @@index([createdAt])
}

model PaymentAttempt {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider        String
  operation       AttemptOperation
  status          AttemptStatus
  errorCode       String?
  errorMessage    String?
  requestPayload  Json?            @db.JsonB
  responsePayload Json?            @db.JsonB

  createdAt DateTime @default(now())

  @@index([provider, status])
  @@index([paymentId, createdAt(sort: Desc)])
}

model Refund {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount          Decimal      @db.Decimal(12, 2)
  status          RefundStatus @default(REQUESTED)
  requestedAt     DateTime     @default(now())
  processedAt     DateTime?
  providerRef     String?
  requestPayload  Json?        @db.JsonB
  responsePayload Json?        @db.JsonB

  @@index([paymentId])
  @@index([status])
  @@index([requestedAt])
}

model PaymentEvent {
  id        String    @id @default(cuid())
  paymentId String
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      EventType
  payload   Json?     @db.JsonB
  createdAt DateTime  @default(now())

  @@index([paymentId, createdAt])
  @@index([type])
}

model OutboxMessage {
  id            String    @id @default(cuid())
  topic         String
  eventType     String
  aggregateId   String?
  payload       Json      @db.JsonB
  published     Boolean   @default(false)
  publishedAt   DateTime?
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([topic, eventType])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String   @unique
  requestHash    String
  method         String
  path           String
  statusCode     Int
  responseBody   Json     @db.JsonB
  firstRequestAt DateTime @default(now())
  lastRequestAt  DateTime @default(now())

  @@index([path, method])
}
